{
  "name": "sologsb-1001-subtitle-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:merge": "esbuild scripts/merge.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/merge.test.mjs && node node_modules/.cache/merge.test.mjs",
    "test:store": "esbuild scripts/store.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/store.test.mjs && node node_modules/.cache/store.test.mjs",
    "test": "npm run test:merge && npm run test:store"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.9.7",
    "pinia": "^3.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@vitejs/plugin-vue": "^5.2.3",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.7.2",
    "vite": "^6.2.3",
    "vue-tsc": "^2.2.8"
  }
}
